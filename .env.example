# Environment variable reference for crm_comercial.
# Copy this file to `.env` and fill in real values -- `.env` is gitignored,
# this file is the versioned guide for what each environment needs.

# --- Database (Docker Compose "db" service) ---------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Connection string used by Prisma (backend/prisma/schema.prisma).
# - Local dev via `docker compose up`: host must be the service name "db"
#   (backend and db share the compose network; "db" has no port exposed to
#   the host, so "localhost" only works if you expose dbs 5432 yourself).
# - Production: point at the real managed Postgres host and enable TLS
#   per that providers requirements (e.g. add ?sslmode=require).
DATABASE_URL=postgresql://<user>:<password>@db:5432/<db_name>?schema=public

# --- Backend server -----------------------------------------------------
PORT=3000
# development | test | production
NODE_ENV=development

# Origen permitido para CORS (frontend SPA). Default: donde corre el
# frontend en Docker Compose / `pnpm dev` local (Vite, puerto 5173).
CORS_ORIGIN=http://localhost:5173

# --- JWT auth (backend/src/config/env.ts, backend/src/lib/jwt.ts) -------
# HS256 secret shared by access and refresh tokens. Minimum 32 characters.
# Generate with: openssl rand -hex 32
# Production: use a distinct, secret-manager-issued value -- never reuse the
# dev secret, and rotate it if it is ever exposed.
JWT_SECRET=

# Token lifetimes in seconds (not "1h"/"30d" -- see D1 in schema comments).
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# --- Seed script only (backend/prisma/seed.ts) ---------------------------
# Password assigned to the seeded dev users. Minimum 12 characters.
# Not read by the app itself -- only by `prisma db seed`. Omit in production
# (seeding is a dev/staging convenience, not a production step).
SEED_PASSWORD=

# Plaintext API key hashed into the seeded Google Forms bridge
# (docs/05-bridges.md §6). Minimum 20 characters. Not read by the app itself
# -- only by `prisma db seed`. Omit in production.
SEED_BRIDGE_CLAVE_API=

# --- Token encryption at rest (backend/src/lib/cifrado-token.ts) -------
# AES-256-GCM master key used to encrypt social-network tokens before they
# are persisted (cuentas_publicitarias.token_cifrado). Exactly 64 hex
# characters (32 bytes). Generate with: openssl rand -hex 32
# Production: use a distinct, secret-manager-issued value -- never reuse the
# dev key, and rotate it if it is ever exposed.
TOKEN_ENCRYPTION_KEY=
