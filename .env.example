POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
PORT=
NODE_ENV=
# Secreto de firma HMAC de los JWT. Mínimo 32 caracteres; el backend no arranca sin él.
# Genéralo localmente:  openssl rand -base64 48
JWT_SECRET=
# TTLs en segundos. Vacío = valores por defecto (3600 = 1 h, 2592000 = 30 días).
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_SECONDS=
# Contraseña de los usuarios de desarrollo que crea `pnpm --filter backend exec prisma db seed`.
# D11: se deja VACÍA a propósito — defínela tú en tu `.env` local (nunca se versiona un valor real).
# Mínimo 12 caracteres. Sin ella, el script de semillas aborta con un mensaje explícito.
SEED_PASSWORD=
