# Environment variable reference for crm_comercial.
# Copy this file to `.env` and fill in real values -- `.env` is gitignored,
# this file is the versioned guide for what each environment needs.

# --- Database (Docker Compose "db" service) ---------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Connection string used by Prisma (backend/prisma/schema.prisma).
# - Local dev via `docker compose up`: host must be the service name "db"
#   (backend and db share the compose network; "db" has no port exposed to
#   the host, so "localhost" only works if you expose dbs 5432 yourself).
# - Production: point at the real managed Postgres host and enable TLS
#   per that providers requirements (e.g. add ?sslmode=require).
DATABASE_URL=postgresql://<user>:<password>@db:5432/<db_name>?schema=public

# --- Application runtime role (D8, Bloque C Etapa 3) --------------------
# `DATABASE_URL` above stays the superuser admin connection, used only by
# `prisma migrate deploy` and `prisma db seed` -- Postgres superusers always
# bypass Row Level Security, so the app itself must NOT connect with it.
# `crm_app` is a dedicated non-superuser role (created by the
# `20260827100000_rls_tenant_isolation` migration, passwordless) whose
# password is set idempotently by `docker-compose.yml`'s backend `command:`
# on every container start, from CRM_APP_DB_PASSWORD below. Never commit a
# real value for either of these -- `.env` is gitignored.
CRM_APP_DB_PASSWORD=
# Same connection target as DATABASE_URL, but as the `crm_app` role. Compose
# does not expand `${VAR}` references written inside `.env` itself, so this
# must be a fully literal connection string (not a reference to
# CRM_APP_DB_PASSWORD above).
DATABASE_URL_APP=postgresql://crm_app:<password>@db:5432/<db_name>?schema=public

# --- Backend server -----------------------------------------------------
PORT=3000
# development | test | production
NODE_ENV=development

# Origen permitido para CORS (frontend SPA). Default: donde corre el
# frontend en Docker Compose / `pnpm dev` local (Vite, puerto 5173).
CORS_ORIGIN=http://localhost:5173

# --- JWT auth (backend/src/config/env.ts, backend/src/lib/jwt.ts) -------
# HS256 secret shared by access and refresh tokens. Minimum 32 characters.
# Generate with: openssl rand -hex 32
# Production: use a distinct, secret-manager-issued value -- never reuse the
# dev secret, and rotate it if it is ever exposed.
JWT_SECRET=

# Token lifetimes in seconds (not "1h"/"30d" -- see D1 in schema comments).
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# --- Seed script only (backend/prisma/seed.ts) ---------------------------
# Password assigned to the seeded dev users. Minimum 12 characters.
# Not read by the app itself -- only by `prisma db seed`. Omit in production
# (seeding is a dev/staging convenience, not a production step).
SEED_PASSWORD=

# Plaintext API key hashed into the seeded Google Forms bridge
# (docs/05-bridges.md §6). Minimum 20 characters. Not read by the app itself
# -- only by `prisma db seed`. Omit in production.
SEED_BRIDGE_CLAVE_API=

# --- Token encryption at rest (backend/src/lib/cifrado-token.ts) -------
# AES-256-GCM master key used to encrypt social-network tokens before they
# are persisted (cuentas_publicitarias.token_cifrado). Exactly 64 hex
# characters (32 bytes). Generate with: openssl rand -hex 32
# Production: use a distinct, secret-manager-issued value -- never reuse the
# dev key, and rotate it if it is ever exposed.
TOKEN_ENCRYPTION_KEY=

# --- Meta adapter (backend/src/services/meta-webhook.service.ts) --------
# Arbitrary token you choose when configuring the webhook subscription in
# the Meta App dashboard. Compared against `hub.verify_token` during the
# one-time GET handshake (per app, not per Page). Any non-empty string.
META_WEBHOOK_VERIFY_TOKEN=

# App Secret from the Meta App dashboard ("Basic settings"). Used as the
# HMAC-SHA256 key to verify `X-Hub-Signature-256` on every leadgen webhook
# notification -- one secret per app, not per Page (unlike the Page Access
# Token, which is per-Page and lives encrypted in
# cuentas_publicitarias.token_cifrado). Never log or expose this value.
META_APP_SECRET=

# App ID from the Meta App dashboard ("Basic settings"). Combined with
# META_APP_SECRET into an App Access Token (`<APP_ID>|<APP_SECRET>`), used as
# the `access_token` query param when calling Graph API's `/debug_token` to
# inspect a Page Access Token's validity/expiration -- one App ID per app,
# not per Page.
META_APP_ID=

# Optional. QA local (test/integration) only: redirects Graph API calls to a
# mock server inside that docker-compose stack (`meta-mock`,
# backend/scripts/) instead of real Meta endpoints. Leave unset everywhere
# else -- meta-webhook.service.ts falls back to the real Graph API URL.
META_GRAPH_API_BASE_URL=


LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=
LINKEDIN_REDIRECT_URI=

LINKEDIN_API_BASE_URL=

# --- WhatsApp Business Platform (backend/src/services/whatsappMessages/) ---
# Reusa META_APP_ID/META_APP_SECRET/META_WEBHOOK_VERIFY_TOKEN de arriba --
# mismo Meta App, con el producto WhatsApp agregado además del de Leads Ads.
# Opcional: si falta, GET /whatsapp/conectar responde 503 en vez de impedir
# el arranque del proceso (igual que LINKEDIN_REDIRECT_URI).
WHATSAPP_OAUTH_REDIRECT_URI=

# --- Meta Ads Marketing API (backend/src/services/metaAds/) ---------------
# OAuth redirect URI for connecting one ad account (`act_<id>`) per company.
# Uses the minimum `ads_read` permission; Facebook and Instagram are split by
# the Insights `publisher_platform` breakdown, not by separate ad accounts.
# Optional: when omitted, GET /meta-ads/conectar returns 503 without blocking
# backend startup.
META_ADS_OAUTH_REDIRECT_URI=

# --- Reports (Bloque E) ---------------------------------------------------
# Internal container directory where generated PDF/XLSX files are written. It
# must not contain credentials or point outside the app tree.
REPORTES_STORAGE_DIR=storage/reportes

# --- Logo upload / Azure Blob Storage (backend/src/lib/azure-blob-storage.ts) ---
# Connection string for the Azure Blob Storage account used to persist
# uploaded company logos (isotipo). Optional: when omitted, POST
# .../apariencia/logo and POST /configuracion-empresa/logo return 503
# without blocking backend startup (same pattern as
# WHATSAPP_OAUTH_REDIRECT_URI / META_ADS_OAUTH_REDIRECT_URI). Never commit a
# real value -- get it from the Azure Storage Account "Access keys" blade.
AZURE_STORAGE_CONNECTION_STRING=

# Blob container name where logos are stored. Not a secret -- has a
# reasonable default in code (`isotipos`) if left unset.
AZURE_STORAGE_CONTAINER_ISOTIPOS=isotipos

# LOCAL AZURITE ONLY -- see docs/contrato-azurite-isotipo.md. The connection
# string's BlobEndpoint uses the Docker Compose internal hostname
# ("azurite:10000"), reachable from the backend container but NOT from the
# host browser. When set, the returned logo URL's origin gets rewritten to
# this value (path untouched) so the browser can actually load <img src>.
# MUST STAY UNSET when AZURE_STORAGE_CONNECTION_STRING points at a real
# Azure Storage Account -- its public endpoint is already resolvable from
# both the backend and the browser, there is no split to fix there.
AZURE_STORAGE_PUBLIC_BASE_URL=
