# Variables de entorno para desplegar el backend en produccion (Azure Container Apps).

# --- Obligatorias: el proceso hace exit(1) si falta alguna ---
DATABASE_URL=postgresql://<admin>:<password>@nexus-postgres.postgres.database.azure.com:5432/crm_arcano?schema=public&sslmode=require
DATABASE_URL_APP=postgresql://crm_app:<password>@nexus-postgres.postgres.database.azure.com:5432/crm_arcano?schema=public&sslmode=require
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_APP_ID=

# --- Usada por docker-entrypoint.sh, no por env.ts (debe ser igual a la de DATABASE_URL_APP) ---
CRM_APP_DB_PASSWORD=

# --- Default "development" en env.ts, hay que pisarlo siempre ---
NODE_ENV=production

# --- Con default razonable, ajustar si hace falta ---
PORT=3000
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
CORS_ORIGIN=https://<dominio-real-del-frontend>
AZURE_STORAGE_CONTAINER_ISOTIPOS=isotipos
AZURE_STORAGE_CONTAINER_REPORTES=reportes

# --- Opcionales: si faltan, el endpoint asociado responde 503 ---
WHATSAPP_OAUTH_REDIRECT_URI=
META_ADS_OAUTH_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_BASE_URL=
# Cadena de conexión de Azure Blob Storage (isotipo de empresa y reportes
# PDF/XLSX generados, Bloque E). Sin ella, la subida de logo responde 503 y
# la generación de reportes falla con "almacenamiento_no_configurado".
AZURE_STORAGE_CONNECTION_STRING=

# --- Solo para backend/prisma/bootstrap-produccion.ts ---
BOOTSTRAP_PASSWORD_HOLDING=
BOOTSTRAP_PASSWORD_SISTEMAS=

# --- Nunca en produccion (dev/seed/QA) ---
# SEED_PASSWORD=
# SEED_BRIDGE_CLAVE_API=
# META_GRAPH_API_BASE_URL=
