generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum RolUsuario {
  ADMINISTRADOR
  SUPERVISOR
  ASESOR
  VENDEDOR

  @@map("rol_usuario")
}

// Bloque B (tenant-empresa-membresia-schema): rol dentro de una `Empresa`,
// distinto de `RolUsuario` (holding-wide, sin cambios). Sin `VENDEDOR` propio
// — el mapeo de backfill fija `VENDEDOR` legado a `ASESOR` con
// `habilitadoParaVenta = true` (spec membership-backfill).
enum RolMembresia {
  ADMINISTRADOR
  SUPERVISOR
  ASESOR

  @@map("rol_membresia")
}

enum SessionScope {
  COMPANY
  HOLDING
}

enum TipoNotificacion {
  LEAD_ASIGNADO
  LEAD_TRASPASADO
  LEAD_SIN_ATENDER
  LEAD_SIN_ASIGNAR
  RECORDATORIO_CITA
  ERROR_BRIDGE
  TOKEN_POR_EXPIRAR
  INTERACCION_REPETIDA
  // M-hardening Bloque A (WU7, spec bridge-log-notifications): un log de
  // bridge ADVERTENCIA por datos incompletos notifica a los SUPERVISOR
  // activos, uno por lead, sin agregación.
  LEAD_DATO_INCOMPLETO
  // Bloque C (Etapa 3, spec "Exhaustion notifies actor and supervisor"):
  // agregado AL FINAL, mismo criterio que SIN_ASIGNAR/ASIGNACION_FALLIDA
  // arriba en `TipoEventoLead` — un `ADD VALUE` sin BEFORE/AFTER lo anexa al
  // final del orden físico de PG. Notifica agotamiento del CAS de asignación
  // (3 intentos, sin backoff) al usuario que intentó reasignar y a su
  // supervisor de empresa.
  ASIGNACION_CONFLICTO

  @@map("tipo_notificacion")
}

enum CanalNotificacion {
  IN_APP

  @@map("canal_notificacion")
}

model Usuario {
  id                 String     @id @default(uuid()) @db.Uuid
  nombre             String     @db.Text
  correo             String     @unique @db.Citext
  passwordHash       String     @map("password_hash") @db.Text
  rol                RolUsuario
  activo             Boolean    @default(true)
  ultimaAsignacionEn DateTime?  @map("ultima_asignacion_en") @db.Timestamptz(6)
  creadoEn           DateTime   @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn      DateTime   @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  refreshTokens        RefreshToken[]
  leadEventos          LeadEvento[]
  // M5 (D1): las columnas se agregan y se leen en M5; M6 las puebla en
  // producción (algoritmo de asignación). Dos relaciones nombradas porque
  // ambas apuntan al mismo modelo `Usuario`.
  leadsComoAsesor      Lead[]                @relation("LeadAsesor")
  leadsComoVendedor    Lead[]                @relation("LeadVendedor")
  respuestasFormulario RespuestaFormulario[]
  // M7: citas donde este usuario es el responsable (`usuario_id`, "Responsable").
  citas                Cita[]
  notificaciones       Notificacion[]
  // Bloque B (tenant-empresa-membresia-schema): backfillado 1:1 por la
  // migración de este cambio (una `Membresia` bootstrap por `Usuario`
  // existente); `Usuario.rol` sigue siendo la ÚNICA fuente de autorización
  // en producción (shadow, no cutover).
  membresias           Membresia[]
  // LinkedIn Lead Sync (TO-BE): el administrador que inicia OAuth queda como
  // dueño auditado de la conexión/state. No implica multi-tenant nuevo; el
  // alcance de empresa sigue viniendo del `Bridge.empresaId` vigente.
  conexionesLinkedInAutorizadas LinkedInConexion[]
  oauthStatesLinkedIn            LinkedInOAuthState[]

  @@map("usuarios")
}

// Bloque B (tenant-empresa-membresia-schema): unidad de tenant. Nace con una
// fila bootstrap de id fijo (migración de este cambio, backfill Fase 1) —
// ninguna `Empresa` real se crea todavía por código de aplicación en este
// cambio.
model Empresa {
  id       String   @id @default(uuid()) @db.Uuid
  nombre   String   @db.Text
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  membresias     Membresia[]
  bridges        Bridge[]
  leads          Lead[]
  // Bloque C (Etapa 3, D4 — RLS de Postgres): denormalizado desde `Lead` en
  // `Cita`/`LeadEvento`/`Notificacion` (ver esos modelos abajo) para que la
  // política RLS de esas tablas compare `empresa_id` directo, sin un join a
  // `leads` por fila.
  citas          Cita[]
  leadEventos    LeadEvento[]
  notificaciones Notificacion[]
  bridgeLogs     BridgeLog[]

  @@map("empresas")
}

// Bloque B (tenant-empresa-membresia-schema): pertenencia de un `Usuario` a
// una `Empresa` con un `RolMembresia` propio. `correo`/`passwordHash`
// habilitan un segundo camino de login (dual-login-routing) — ambos quedan
// NULL en todo backfill (spec membership-backfill); ningún código de este
// cambio los escribe todavía. `@@unique([usuarioId, empresaId, rol])`
// (spec, "Duplicate membership rejected"): rechaza la tripleta repetida.
// `activa=false` es la baja lógica — la fila nunca se borra (spec, "Removal
// is a soft toggle").
model Membresia {
  id                  String       @id @default(uuid()) @db.Uuid
  usuarioId           String       @map("usuario_id") @db.Uuid
  empresaId           String       @map("empresa_id") @db.Uuid
  rol                 RolMembresia
  // Backfill: `true` solo para `VENDEDOR` legado (mapeado a `ASESOR`);
  // `false` para todo el resto, incluidos los `ASESOR` legados (spec
  // membership-backfill).
  habilitadoParaVenta Boolean      @default(false) @map("habilitado_para_venta")
  correo              String?      @unique @db.Citext
  passwordHash        String?      @map("password_hash") @db.Text
  activa              Boolean      @default(true)
  creadoEn            DateTime     @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn       DateTime     @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  usuario       Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([usuarioId, empresaId, rol])
  // Fase 2 (diseño, shadow authorizer hot path): "active memberships for
  // this usuarioId", no empresa-scoped.
  @@index([usuarioId, activa])
  @@index([empresaId, rol])
  @@map("membresias")
}

// D-A: `jti` (UUID v4 generado en la emisión) es la PK — el 100% de los
// accesos a esta tabla es por `jti` (rotación, logout, detección de
// reutilización); un id sustituto no aportaría nada.
model RefreshToken {
  jti        String    @id @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  // D-B: sha256hex del JWT de refresco compacto completo. Nunca el token en
  // claro. El control primario de seguridad es la firma HMAC del JWT; este
  // hash es defensa en profundidad (ata la fila al string exacto del token).
  hash       String    @db.Text
  expiraEn   DateTime  @map("expira_en") @db.Timestamptz(6)
  revocadoEn DateTime? @map("revocado_en") @db.Timestamptz(6)
  creadoEn   DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  sessionScope SessionScope @map("session_scope")
  // Bloque B (dual-login-routing): nulo para toda sesión emitida antes de
  // este cambio (spec, "Active session after migration") y para toda sesión
  // emitida vía `Usuario.correo` (camino holding-wide, sin membresía).
  // SetNull (no Cascade, mismo criterio que `Lead.asesor`/`vendedor`): dar de
  // baja una `Membresia` nunca debe invalidar sesiones vigentes.
  membresiaId String?  @map("membresia_id") @db.Uuid

  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  membresia Membresia? @relation(fields: [membresiaId], references: [id], onDelete: Restrict)

  @@index([usuarioId, revocadoEn])
  @@map("refresh_tokens")
}

enum OrigenLead {
  NUEVO
  REINGRESO

  @@map("origen_lead")
}

enum EtapaLead {
  NUEVO
  CONTACTADO
  CITA
  VENTA
  NO_VENTA

  @@map("etapa_lead")
}

enum TipoEventoLead {
  INGRESO
  ASIGNACION
  REASIGNACION
  TRASPASO
  CAMBIO_ETAPA
  CAMBIO_SEMAFORO
  INTERACCION_REPETIDA
  CITA_AGENDADA
  CITA_REPROGRAMADA
  SLA_INCUMPLIDO
  CIERRE
  // M6 (D6/DD3): agregado AL FINAL — `ADD VALUE` sin BEFORE/AFTER lo anexa al
  // final del orden físico de PG; declararlo en otra posición del DSL
  // crearía deriva permanente entre `schema.prisma` y `pg_enum`. Señala que
  // no hubo candidatos activos del rol requerido al momento de la
  // asignación automática (docs/02 §3.5).
  SIN_ASIGNAR
  // F3/F4 (diseño D-A2, revisión 2): agregado AL FINAL, mismo criterio que
  // SIN_ASIGNAR arriba. Señala que la asignación automática POST-COMMIT
  // agotó sus 3 reintentos — distinto de SIN_ASIGNAR ("no había candidatos",
  // estado de negocio) porque este es un fallo de infraestructura/operación;
  // sobrecargar SIN_ASIGNAR ocultaría el incidente y dispararía una
  // notificación falsa. Ver docs/06-modulos-backend.md §M6.
  ASIGNACION_FALLIDA
  ASIGNACION_CONFLICTO

  @@map("tipo_evento_lead")
}

model Cliente {
  id                  String   @id @default(uuid()) @db.Uuid
  nombre              String?  @db.Text
  telefonoOriginal    String?  @map("telefono_original") @db.Text
  telefonoNormalizado String?  @unique @map("telefono_normalizado") @db.Text
  telefonoValido      Boolean  @default(false) @map("telefono_valido")
  creadoEn            DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  correos CorreoCliente[]
  leads   Lead[]
  // Bloque B (Fase 3, dedup shadow): cola de revisión no invasiva — ver
  // `LeadAbiertoRevisionPendiente` abajo. Vacía en producción hasta que el
  // comparador en sombra detecte la primera colisión cross-empresa.
  revisionesPendientes LeadAbiertoRevisionPendiente[]

  @@map("clientes")
}

model CorreoCliente {
  id                String  @id @default(uuid()) @db.Uuid
  clienteId         String  @map("cliente_id") @db.Uuid
  correo            String  @db.Text
  correoNormalizado String  @map("correo_normalizado") @db.Citext
  esPrincipal       Boolean @default(false) @map("es_principal")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, correoNormalizado])
  @@index([correoNormalizado])
  @@map("correos_cliente")
}

enum Semaforo {
  ROJO
  AMARILLO
  VERDE

  @@map("semaforo")
}

enum FormaPago {
  CONTADO
  CREDITO
  FINANCIAMIENTO

  @@map("forma_pago")
}

// Rebanada M3 (D2): `campania_id` sigue fuera de alcance (M5 filtra campaña
// sobre el jsonb crudo de M4, D2 de la propuesta M5). `red_social`,
// `campos_dinamicos` y `payload_original` los añadió M4 (ver abajo). M5
// agrega semaforo/puntuacion (D14, nullable — sin backfill destructivo),
// asesor_id/vendedor_id/sla_inicio_en (D1 — M5 los agrega y lee, M6 los
// puebla en producción) y los campos de cierre (D13).
model Lead {
  id                String     @id @default(uuid()) @db.Uuid
  clienteId         String     @map("cliente_id") @db.Uuid
  origen            OrigenLead
  etapa             EtapaLead  @default(NUEVO)
  // M4: nulo en leads previos a esta rebanada o de orígenes que aún no
  // reportan estos campos (docs/05-bridges.md §2). M5 DD1: la ausencia de
  // `red_social`/`payload_original` en leads creados vía M4 antes de esta
  // rebanada es un defecto de M4 (ver DD1 del diseño M5), no el estado
  // esperado — la migración M5 hace un backfill NULL-only (D14-safe) para
  // los que sí tienen recepción vinculada.
  redSocial         RedSocial? @map("red_social")
  camposDinamicos   Json?      @map("campos_dinamicos") @db.JsonB
  payloadOriginal   Json?      @map("payload_original") @db.JsonB
  // M5 (D14): nullable — los leads que M4 ya creó (sin calificar) quedan en
  // `null`. "Sin calificar" es un cuarto valor de filtro explícito, nunca un
  // default oculto.
  semaforo          Semaforo?
  puntuacion        Int?
  // M5 (D1): M5 agrega y lee estas columnas; el algoritmo de asignación
  // automática que las puebla en producción es de M6. Las pruebas de M5
  // asignan por seed/fixture.
  asesorId          String?    @map("asesor_id") @db.Uuid
  vendedorId        String?    @map("vendedor_id") @db.Uuid
  // M5 (D9): nulo mientras no haya asesor asignado — "sin_iniciar" (D15). El
  // reinicio del reloj en cada reasignación es de M6.
  slaInicioEn       DateTime?  @map("sla_inicio_en") @db.Timestamptz(6)
  ingresadoEn       DateTime   @map("ingresado_en") @db.Timestamptz(6)
  cerradoEn         DateTime?  @map("cerrado_en") @db.Timestamptz(6)
  // M5 (D13): datos de cierre en columnas dedicadas — M9 los reporta por
  // monto y por forma de pago con agregación SQL directa, no jsonb.
  montoVenta        Decimal?   @map("monto_venta") @db.Decimal(12, 2)
  observacionCierre String?    @map("observacion_cierre") @db.Text
  productoServicio  String?    @map("producto_servicio") @db.Text
  formaPago         FormaPago? @map("forma_pago")

  // M-hardening Bloque A (WU4, spec lead-attribution, D6/D9): atribución
  // canónica resuelta por `atribucion.service.ts::resolverAtribucion` en
  // ingesta (lookup de dos pasos: cuenta primero, campaña después — D6).
  // Ambas FKs son nullable y degradan a `null` en silencio cuando no hay
  // match (nunca fallan la ingesta); los 3 escalares crudos se persisten
  // siempre, con o sin match canónico.
  cuentaPublicitariaId String?  @map("cuenta_publicitaria_id") @db.Uuid
  campaniaId           String?  @map("campania_id") @db.Uuid
  idExternoCuenta      String?  @map("id_externo_cuenta") @db.Text
  idExternoCampania    String?  @map("id_externo_campania") @db.Text
  nombreCampania       String?  @map("nombre_campania") @db.Text

  // Bloque B (Fase 3, lead-empresa-derivation): derivado desde
  // `Bridge.empresaId` en ingesta (`resolverEmpresaIdDesdeBridge`).
  // Bloque C (D4, Fase 2/Stage 2 — cutover bloqueante): NOT NULL desde esta
  // migración — confirmado sin datos de producción (memoria #102), así que
  // el cutover no requiere backfill/quarantine/deny. `Bridge.empresaId`
  // (abajo en este mismo archivo) migra NOT NULL en la misma migración por
  // la misma razón: un `Bridge` sin empresa es la única vía por la que un
  // `Lead.empresaId` podría volver a quedar huérfano.
  empresaId            String   @map("empresa_id") @db.Uuid
  // Bloque C (Etapa 3, spec "Optimistic concurrency on lead assignment"):
  // versión monotónica Lead-wide (R-C, spec) — cualquier escritura vía
  // `assignResponsable`/`assignResponsableBulk` hace CAS sobre esta columna
  // y la incrementa en 1 al ganar. Arranca en 0 para todo lead existente
  // (backfill implícito del default de columna).
  version              Int      @default(0)

  cliente              Cliente               @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  // M5 (D1): SetNull — un usuario dado de baja (`activo = false`) nunca se
  // borra, y un lead no debe quedar bloqueado por la baja de su asesor.
  asesor               Usuario?              @relation("LeadAsesor", fields: [asesorId], references: [id], onDelete: SetNull)
  vendedor             Usuario?              @relation("LeadVendedor", fields: [vendedorId], references: [id], onDelete: SetNull)
  // M-hardening Bloque A (WU4): SetNull, mismo criterio que asesor/vendedor
  // arriba — borrar una cuenta/campaña nunca debe bloquear al lead que la
  // referencia.
  cuentaPublicitaria   CuentaPublicitaria?   @relation(fields: [cuentaPublicitariaId], references: [id], onDelete: SetNull)
  campania             Campania?             @relation(fields: [campaniaId], references: [id], onDelete: SetNull)
  eventos              LeadEvento[]
  leadsRecibidos       LeadRecibido[]
  respuestasFormulario RespuestaFormulario[]
  citas                Cita[]
  notificaciones       Notificacion[]
  // Bloque C (D4, Fase 2/Stage 2): Restrict, no SetNull — `empresaId` es
  // NOT NULL ahora (arriba); `SetNull` violaría esa restricción al borrar
  // una `Empresa`. Mismo criterio de mandatory-FK que `cliente` arriba.
  empresa              Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  // Bloque B (Fase 3, dedup shadow): filas de la cola de revisión donde este
  // lead es el "lead abierto" en colisión — ver `LeadAbiertoRevisionPendiente`.
  revisionesPendientes LeadAbiertoRevisionPendiente[]

  @@index([clienteId, etapa])
  @@index([clienteId, cerradoEn(sort: Desc)])
  @@index([empresaId], map: "idx_leads_empresa")
  // D11 (docs/03-modelo-datos.md §leads): el listado filtrado es el endpoint
  // más caliente del sistema — índices desde el primer día. El índice
  // parcial `idx_leads_sla` (`WHERE cerrado_en IS NULL`) no es expresable en
  // el DSL de Prisma (sin soporte de índices parciales/filtrados a la fecha)
  // y se agrega a mano en la migración — ver `migration.sql` de este cambio.
  @@index([asesorId, etapa], map: "idx_leads_asesor_etapa")
  @@index([vendedorId, etapa], map: "idx_leads_vendedor_etapa")
  @@index([etapa, ingresadoEn(sort: Desc)], map: "idx_leads_etapa_ingreso")
  @@index([redSocial], map: "idx_leads_red_social")
  @@index([campaniaId], map: "idx_leads_campania")
  @@index([cuentaPublicitariaId], map: "idx_leads_cuenta_publicitaria")
  @@map("leads")
}

// M5: `semaforo_anterior`/`semaforo_nuevo` (D17 — una fila `CAMBIO_SEMAFORO`
// independiente de `CAMBIO_ETAPA` cuando ambos cambian juntos, misma
// transacción).
model LeadEvento {
  id               String         @id @default(uuid()) @db.Uuid
  leadId           String         @map("lead_id") @db.Uuid
  usuarioId        String?        @map("usuario_id") @db.Uuid
  tipo             TipoEventoLead
  etapaAnterior    EtapaLead?     @map("etapa_anterior")
  etapaNueva       EtapaLead?     @map("etapa_nueva")
  semaforoAnterior Semaforo?      @map("semaforo_anterior")
  semaforoNuevo    Semaforo?      @map("semaforo_nuevo")
  detalle          Json?          @db.JsonB
  ocurridoEn       DateTime       @default(now()) @map("ocurrido_en") @db.Timestamptz(6)
  // Bloque C (Etapa 3, D4 — RLS): denormalizado desde `Lead.empresaId` en la
  // migración de este cambio (backfill vía join por `leadId`). NOT NULL —
  // todo `LeadEvento` cuelga de un `Lead`, que ya es NOT NULL en `empresaId`
  // (cutover Bloque C, Fase 2/Stage 2).
  empresaId        String         @map("empresa_id") @db.Uuid

  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([leadId, ocurridoEn])
  @@index([tipo, ocurridoEn])
  @@index([empresaId], map: "idx_lead_eventos_empresa")
  @@map("lead_eventos")
}

// M5 (D8, docs/03 §respuestas_formulario): historial, nunca sobrescritura —
// una fila por cada envío de formulario, vía `PATCH /etapa` o
// `POST /formulario` (D16). `versionRubrica` (D12) congela la versión de la
// rúbrica vigente al momento del cálculo; un cambio posterior de rúbrica no
// recalcula puntuaciones ya persistidas.
model RespuestaFormulario {
  id             String    @id @default(uuid()) @db.Uuid
  leadId         String    @map("lead_id") @db.Uuid
  usuarioId      String    @map("usuario_id") @db.Uuid
  etapa          EtapaLead
  respuestas     Json      @db.JsonB
  puntuacion     Int
  semaforo       Semaforo
  versionRubrica String    @map("version_rubrica") @db.Text
  registradoEn   DateTime  @default(now()) @map("registrado_en") @db.Timestamptz(6)

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([leadId, registradoEn])
  @@map("respuestas_formulario")
}

model Notificacion {
  id        String            @id @default(uuid()) @db.Uuid
  usuarioId String            @map("usuario_id") @db.Uuid
  tipo      TipoNotificacion
  canal     CanalNotificacion @default(IN_APP)
  titulo    String            @db.Text
  mensaje   String            @db.Text
  leadId    String?           @map("lead_id") @db.Uuid
  leidaEn   DateTime?         @map("leida_en") @db.Timestamptz(6)
  creadaEn  DateTime          @default(now()) @map("creada_en") @db.Timestamptz(6)
  // Bloque C (Etapa 3, D4 — RLS): denormalizado desde `Lead.empresaId` cuando
  // `leadId` está presente (backfill vía join); NULL para notificaciones
  // holding-wide (mismo convenio ya existente en
  // `notificacion.repository.ts::findActiveRecipientIds`, `empresaId: null` =
  // sin restricción). La política RLS de `notificaciones` deja pasar
  // `empresa_id IS NULL` como parte del mismo `OR` de contexto unrestricted.
  empresaId String?           @map("empresa_id") @db.Uuid

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  @@index([usuarioId, creadaEn(sort: Desc)], map: "idx_notificaciones_usuario_creada")
  @@index([leadId])
  @@index([empresaId], map: "idx_notificaciones_empresa")
  @@map("notificaciones")
}

enum ModalidadCita {
  PRESENCIAL
  VIRTUAL
  TELEFONICA

  @@map("modalidad_cita")
}

enum EstadoCita {
  AGENDADA
  CUMPLIDA
  NO_ASISTIO
  // M7 (diseño, decisión de reprogramación): el trabajo de recordatorio (§4,
  // docs/06) filtra estrictamente `estado = AGENDADA` — para que una cita
  // reprogramada siga recibiendo su recordatorio 1h antes de la NUEVA fecha,
  // `citas.service.ts::rescheduleCita` deja el `estado` en `AGENDADA` tras
  // reprogramar (mismo registro, `programadaPara` actualizada), nunca en
  // `REPROGRAMADA`. Este valor se conserva en el enum por fidelidad exacta
  // con `docs/03-modelo-datos.md` §citas, pero ningún camino de código actual
  // lo persiste — queda disponible para un futuro estado transitorio propio
  // sin requerir otra migración.
  REPROGRAMADA
  CANCELADA

  @@map("estado_cita")
}

// M7 (docs/03-modelo-datos.md §citas): un registro por reunión agendada con
// el lead. Es un registro ASOCIADO al lead, no un reemplazo del flujo de
// etapa/formulario de M5 — marcar el resultado de una cita (`CUMPLIDA`/
// `NO_ASISTIO`) nunca mueve `leads.etapa` ni escribe `respuestas_formulario`
// por sí solo; el vendedor sigue completando el formulario de la etapa CITA
// (docs/04-formularios-semaforo.md §5) por su propio flujo ya existente
// (`PATCH /leads/:id/etapa` o `POST /leads/:id/formulario`, M5).
model Cita {
  id                  String        @id @default(uuid()) @db.Uuid
  leadId              String        @map("lead_id") @db.Uuid
  // "Responsable" (docs/03): quien la agenda por defecto (D-M7a, diseño M7);
  // Admin/Supervisor pueden asignarla a otro usuario explícito.
  usuarioId           String        @map("usuario_id") @db.Uuid
  programadaPara      DateTime      @map("programada_para") @db.Timestamptz(6)
  modalidad           ModalidadCita
  estado              EstadoCita    @default(AGENDADA)
  notas               String?       @db.Text
  recordatorioEnviado Boolean       @default(false) @map("recordatorio_enviado")
  creadoEn            DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  // Bloque C (Etapa 3, D4 — RLS): denormalizado desde `Lead.empresaId` en la
  // migración de este cambio (backfill vía join por `leadId`). NOT NULL —
  // toda `Cita` cuelga de un `Lead`, que ya es NOT NULL en `empresaId`
  // (cutover Bloque C, Fase 2/Stage 2).
  empresaId           String        @map("empresa_id") @db.Uuid

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Restrict (no SetNull): a diferencia de `Lead.asesorId`/`vendedorId`
  // (M5 D1, columna nullable), `usuario_id` de `citas` es NOT NULL en el
  // modelo de datos (docs/03) — mismo criterio que
  // `RespuestaFormulario.usuario` (M5), que también es requerido.
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([empresaId], map: "citas_empresa_id_idx")
  // M7: forma de consulta del trabajo de recordatorio (`estado = AGENDADA`,
  // `recordatorioEnviado = false`, `programadaPara` en la ventana de 1h) —
  // volumen de `citas` muy por debajo de `leads`, así que un índice compuesto
  // regular basta; no se justifica el índice parcial a mano que sí requirió
  // `idx_leads_sla` (DD1, M5/M6) para la tabla más caliente del sistema.
  @@index([estado, programadaPara])
  @@map("citas")
}

enum RedSocial {
  FACEBOOK
  INSTAGRAM
  X
  LINKEDIN
  GOOGLE_FORMS
  // bridgeApi: pull genérico vía GET + X-Api-Key, mapeo de campos
  // configurable por bridge (`Bridge.configuracionJson`) en vez de un
  // adaptador nuevo por proveedor.
  API_EXTERNA

  @@map("red_social")
}

enum EstadoBridge {
  ACTIVO
  TOKEN_EXPIRADO
  ERROR
  INACTIVO

  @@map("estado_bridge")
}

enum NivelBridgeLog {
  INFO
  ADVERTENCIA
  ERROR

  @@map("nivel_bridge_log")
}

enum EstadoRecepcion {
  PENDIENTE
  PROCESANDO
  REINTENTO
  PROCESADO
  FALLA_MANUAL

  @@map("estado_recepcion")
}

// Decisión confirmada (2026-08-18, docs/03-modelo-datos.md
// §cuentas_publicitarias): el estado de expiración/validez de un token de
// Meta vive por Página en `CuentaPublicitaria.estadoToken`, no en
// `Bridge.estado` — cada Page Access Token expira o se revoca de forma
// independiente. `Bridge.estado.TOKEN_EXPIRADO` queda reservado para un
// futuro bridge sin granularidad por cuenta (p. ej. LinkedIn).
enum EstadoTokenCuenta {
  VALIDO
  TOKEN_EXPIRADO
  ERROR

  @@map("estado_token_cuenta")
}

enum EstadoConexionLinkedIn {
  ACTIVA
  TOKEN_EXPIRADO
  REVOCADA
  ERROR

  @@map("estado_conexion_linkedin")
}

enum TipoFuenteLinkedIn {
  SPONSORED_ACCOUNT
  ORGANIZATION

  @@map("tipo_fuente_linkedin")
}

enum TipoLeadLinkedIn {
  SPONSORED
  EVENT
  COMPANY
  ORGANIZATION_PRODUCT

  @@map("tipo_lead_linkedin")
}

enum EstadoSuscripcionLinkedIn {
  PENDIENTE
  ACTIVA
  ERROR
  REVOCADA

  @@map("estado_suscripcion_linkedin")
}

// Conexión con una red social (docs/05-bridges.md §1, §7). El cifrado de
// token (`CuentaPublicitaria.tokenCifrado`/`secretoWebhook`) se añade en el
// módulo que lo consume (adaptador Meta, M4) — ver `CuentaPublicitaria` abajo.
model Bridge {
  id           String       @id @default(uuid()) @db.Uuid
  redSocial    RedSocial    @map("red_social")
  nombre       String       @db.Text
  // F2: hash sha256hex irreversible de la clave de API (`X-Bridge-Key`,
  // docs/05-bridges.md §5). La clave en claro nunca se persiste.
  claveApiHash String       @unique @map("clave_api_hash") @db.Text
  // Desactivado por defecto (docs/05-bridges.md §6): un bridge nuevo no
  // recibe leads hasta activación explícita.
  estado       EstadoBridge @default(INACTIVO)
  ultimoLeadEn DateTime?    @map("ultimo_lead_en") @db.Timestamptz(6)
  // Anti-spam del trabajo programado "bridge sin actividad por 72h"
  // (docs/05-bridges.md §8, docs/06-modulos-backend.md): mismo patrón que
  // `Cita.recordatorioEnviado` — evita reenviar la misma advertencia en
  // cada tick de 15 min mientras el bridge sigue mudo.
  // `touchUltimoLeadEn` la resetea a `false` cuando llega un lead nuevo.
  advertenciaMudoEnviada Boolean @default(false) @map("advertencia_mudo_enviada")
  // Bloque B (Fase 3, lead-empresa-derivation): resuelto por
  // `atribucion.service.ts::resolverEmpresaIdDesdeBridge` en ingesta.
  // Bloque C (D4, Fase 2/Stage 2 — cutover bloqueante): NOT NULL desde esta
  // migración — un `Bridge` sin empresa era la única vía por la que
  // `Lead.empresaId` podía quedar huérfano; cerrar este hueco en el origen
  // hace innecesaria cualquier guarda downstream. `POST /bridges` ahora
  // exige `empresaId` en el body (`bridges.schema.ts`).
  empresaId String @map("empresa_id") @db.Uuid

  // bridgeApi (RedSocial.API_EXTERNA): NULL en Meta/Google Forms/etc.
  // Forma: `ConfiguracionBridgeApi`
  // (`types/bridgeApi/configuracion-bridge-api.ts`) — url, parametroFecha
  // opcional, mapeoCampos (clave externa -> campo fijo de LeadEntrante).
  // Validado en el borde por `bridges.schema.ts`, no acá.
  configuracionJson Json? @map("configuracion_json") @db.JsonB

  // bridgeApi: API key del sistema EXTERNO, cifrada AES-256-GCM vía
  // `lib/cifrado-token.ts` (mismo mecanismo que
  // `CuentaPublicitaria.tokenCifrado`). No es `claveApiHash`: esa es un hash
  // irreversible de una key que NOSOTROS emitimos y solo verificamos; esta
  // hay que poder descifrarla para reenviarla en el header `X-Api-Key` de
  // cada poll.
  credencialExternaCifrada String? @map("credencial_externa_cifrada") @db.Text

  bridgeLogs          BridgeLog[]
  leadsRecibidos      LeadRecibido[]
  cuentasPublicitarias CuentaPublicitaria[]
  // LinkedIn OAuth: una conexión vigente por bridge y states efímeros de
  // autorización. Los tokens viven cifrados en `LinkedInConexion`, no en
  // `CuentaPublicitaria.tokenCifrado` porque esa columna es Meta-céntrica.
  linkedinConexion     LinkedInConexion?
  linkedinOAuthStates  LinkedInOAuthState[]
  // Bloque C (D4): Restrict, no SetNull — `empresaId` es NOT NULL ahora.
  empresa              Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@map("bridges")
}

// Unidad de suscripción de la plataforma (D-M4-fundacion, diseño
// m4-bridges-crud-fundacion). Para Meta, `idExterno` es el ID de la PÁGINA de
// Facebook — el webhook y el Page Access Token son por Página, nunca por
// Business Manager ni por cuenta publicitaria genérica (docs/05-bridges.md
// §3). `@@unique([bridgeId, idExterno])` da al futuro adaptador un target de
// upsert determinístico y bloquea filas de Página duplicadas.
model CuentaPublicitaria {
  id       String @id @default(uuid()) @db.Uuid
  bridgeId String @map("bridge_id") @db.Uuid
  idExterno String @map("id_externo") @db.Text
  nombre   String @db.Text
  // Cuenta profesional de Instagram vinculada a esa misma Página. Instagram
  // no tiene suscripción ni token propios — sus leads llegan por el webhook
  // de la Página vinculada, así que nunca es una fila aparte (docs/05-bridges.md
  // §3). NULL en el resto de las redes.
  idExternoVinculado String? @map("id_externo_vinculado") @db.Text
  activa   Boolean @default(true)
  // Decisión confirmada (2026-08-18, docs/03-modelo-datos.md
  // §cuentas_publicitarias): granularidad por Página — cada Page Access
  // Token de Meta expira o se revoca de forma independiente, así que este
  // estado vive acá y no en `Bridge.estado`. Nace `VALIDO`: una fila que
  // todavía no cargó token no está "expirada".
  estadoToken   EstadoTokenCuenta @default(VALIDO) @map("estado_token")
  // Nulo hasta que se carga un token de Meta (endpoint de administración de
  // token, fuera de esta rebanada). AES-256-GCM vía `lib/cifrado-token.ts`;
  // nunca sale por la API.
  tokenCifrado  String?           @map("token_cifrado") @db.Text
  tokenExpiraEn DateTime?         @map("token_expira_en") @db.Timestamptz(6)
  secretoWebhook String?          @map("secreto_webhook") @db.Text
  // M-hardening Bloque A (WU5, spec token-expiry-alerting): marcador de
  // idempotencia — guarda el ÚLTIMO `tokenExpiraEn` ya alertado. Nullable,
  // NO booleano: un token renovado mueve `tokenExpiraEn`, así que la alerta
  // se autorearma sin necesitar una escritura de reseteo separada (a
  // diferencia de `Bridge.advertenciaMudoEnviada`).
  alertaExpiracionParaEn DateTime? @map("alerta_expiracion_para_en") @db.Timestamptz(6)

  bridge    Bridge     @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  campanias Campania[]
  leads     Lead[]
  // LinkedIn sponsored accounts pueden reutilizar `CuentaPublicitaria` para
  // atribución canónica. Organizaciones LinkedIn quedan como fuente sin cuenta
  // publicitaria asociada.
  linkedinFuentes LinkedInFuente[]

  @@unique([bridgeId, idExterno])
  @@map("cuentas_publicitarias")
}

// Campaña reportada por la plataforma de origen (docs/03-modelo-datos.md).
// `redSocial` queda denormalizada a propósito (decisión de diseño
// confirmada, docs/03 §campanias): una campaña pertenece a una sola red, no
// se fusionan nombres homónimos entre plataformas.
model Campania {
  id                   String    @id @default(uuid()) @db.Uuid
  cuentaPublicitariaId String    @map("cuenta_publicitaria_id") @db.Uuid
  idExterno            String    @map("id_externo") @db.Text
  nombre               String    @db.Text
  redSocial            RedSocial @map("red_social")
  activa               Boolean   @default(true)

  cuentaPublicitaria CuentaPublicitaria @relation(fields: [cuentaPublicitariaId], references: [id], onDelete: Cascade)
  leads              Lead[]

  @@unique([cuentaPublicitariaId, idExterno])
  @@map("campanias")
}

// Conexión OAuth de LinkedIn Lead Sync. Guarda credenciales del miembro que
// autorizó la aplicación, cifradas con `TOKEN_ENCRYPTION_KEY`. Una conexión
// puede descubrir y activar varias fuentes (`LinkedInFuente`).
model LinkedInConexion {
  id                     String                 @id @default(uuid()) @db.Uuid
  bridgeId               String                 @unique @map("bridge_id") @db.Uuid
  autorizadoPorUsuarioId String                 @map("autorizado_por_usuario_id") @db.Uuid
  memberUrn              String?                @map("member_urn") @db.Text
  accessTokenCifrado     String                 @map("access_token_cifrado") @db.Text
  refreshTokenCifrado    String?                @map("refresh_token_cifrado") @db.Text
  accessTokenExpiraEn    DateTime               @map("access_token_expira_en") @db.Timestamptz(6)
  refreshTokenExpiraEn   DateTime?              @map("refresh_token_expira_en") @db.Timestamptz(6)
  scopes                 String[]
  estado                 EstadoConexionLinkedIn @default(ACTIVA)
  revocadoEn             DateTime?              @map("revocado_en") @db.Timestamptz(6)
  creadoEn               DateTime               @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn          DateTime               @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  bridge         Bridge           @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  autorizadoPor  Usuario          @relation(fields: [autorizadoPorUsuarioId], references: [id], onDelete: Restrict)
  fuentes        LinkedInFuente[]

  @@index([estado, accessTokenExpiraEn], map: "idx_linkedin_conexiones_estado_access_expira")
  @@map("linkedin_conexiones")
}

// State efímero anti-CSRF para OAuth LinkedIn. Solo se persiste el hash del
// state y se consume una vez; el valor plano nunca queda en base de datos.
model LinkedInOAuthState {
  id        String    @id @default(uuid()) @db.Uuid
  stateHash String    @unique @map("state_hash") @db.Text
  bridgeId  String    @map("bridge_id") @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  expiraEn  DateTime  @map("expira_en") @db.Timestamptz(6)
  usadoEn   DateTime? @map("usado_en") @db.Timestamptz(6)
  creadoEn  DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  bridge  Bridge  @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([expiraEn], map: "idx_linkedin_oauth_states_expira")
  @@index([bridgeId, usuarioId], map: "idx_linkedin_oauth_states_bridge_usuario")
  @@map("linkedin_oauth_states")
}

// Fuente LinkedIn seleccionable después del OAuth. Una misma autorización puede
// tener varias fuentes activas; cada fuente representa un owner + tipo de lead.
model LinkedInFuente {
  id                         String                    @id @default(uuid()) @db.Uuid
  conexionId                 String                    @map("conexion_id") @db.Uuid
  cuentaPublicitariaId       String?                   @map("cuenta_publicitaria_id") @db.Uuid
  tipo                       TipoFuenteLinkedIn
  ownerUrn                   String                    @map("owner_urn") @db.Text
  nombre                     String                    @db.Text
  tipoLead                   TipoLeadLinkedIn          @map("tipo_lead")
  activa                     Boolean                   @default(false)
  estadoSuscripcion          EstadoSuscripcionLinkedIn @default(PENDIENTE) @map("estado_suscripcion")
  subscriptionId             String?                   @map("subscription_id") @db.Text
  ultimaSincronizacionEn     DateTime?                 @map("ultima_sincronizacion_en") @db.Timestamptz(6)
  creadoEn                   DateTime                  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn              DateTime                  @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  conexion           LinkedInConexion    @relation(fields: [conexionId], references: [id], onDelete: Cascade)
  cuentaPublicitaria CuentaPublicitaria? @relation(fields: [cuentaPublicitariaId], references: [id], onDelete: SetNull)
  formularios        LinkedInFormulario[]

  @@unique([conexionId, ownerUrn, tipoLead], map: "linkedin_fuentes_conexion_owner_tipo_lead_key")
  @@index([activa, estadoSuscripcion], map: "idx_linkedin_fuentes_activa_estado_suscripcion")
  @@index([ownerUrn], map: "idx_linkedin_fuentes_owner_urn")
  @@map("linkedin_fuentes")
}

// Snapshot del formulario/version usado para mapear respuestas por
// `questionId`/`predefinedField`, nunca por el texto visible de la pregunta.
model LinkedInFormulario {
  id                   String   @id @default(uuid()) @db.Uuid
  fuenteId             String   @map("fuente_id") @db.Uuid
  versionedFormUrn     String   @map("versioned_form_urn") @db.Text
  nombre               String?  @db.Text
  contenido            Json     @db.JsonB
  activo               Boolean  @default(true)
  sincronizadoEn       DateTime @map("sincronizado_en") @db.Timestamptz(6)

  fuente LinkedInFuente @relation(fields: [fuenteId], references: [id], onDelete: Cascade)

  @@unique([fuenteId, versionedFormUrn], map: "linkedin_formularios_fuente_versioned_form_key")
  @@map("linkedin_formularios")
}

// Bitácora de errores/eventos por bridge (docs/05-bridges.md §8). Se escribe
// siempre fuera de la transacción de ingesta (DD5, diseño M4) para que
// sobreviva a un rollback.
model BridgeLog {
  id         String         @id @default(uuid()) @db.Uuid
  bridgeId   String?        @map("bridge_id") @db.Uuid
  nivel      NivelBridgeLog
  mensaje    String         @db.Text
  payload    Json?          @db.JsonB
  ocurridoEn DateTime       @default(now()) @map("ocurrido_en") @db.Timestamptz(6)
  empresaId  String?        @map("empresa_id") @db.Uuid

  bridge Bridge? @relation(fields: [bridgeId], references: [id], onDelete: SetNull)
  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([bridgeId, ocurridoEn(sort: Desc)])
  @@index([empresaId], map: "idx_bridge_logs_empresa")
  @@map("bridge_logs")
}

// Recepción cruda de cada lead entrante (F1: ausente hasta ahora de
// docs/03-modelo-datos.md). `UNIQUE(bridge_id, id_externo_lead)` es la
// defensa de idempotencia contra reintentos de webhook (docs/05-bridges.md
// §2). `leadId` es nulo hasta que la transacción de ingesta lo resuelve —
// no hay máquina de estados de recepción (D2, diseño M4, retirada).
model LeadRecibido {
  id               String   @id @default(uuid()) @db.Uuid
  bridgeId         String   @map("bridge_id") @db.Uuid
  idExternoLead    String   @map("id_externo_lead") @db.Text
  leadId           String?  @map("lead_id") @db.Uuid
  // Cuerpo crudo recibido; incluye la atribución de campaña sin resolver
  // (`idExternoCampania`, `nombreCampania`, `idExternoCuenta` — D4, diseño
  // M4: no se crean `campanias`/`cuentas_publicitarias` en esta rebanada).
  payload          Json     @db.JsonB
  datosIncompletos Boolean  @default(false) @map("datos_incompletos")
  recibidoEn       DateTime @default(now()) @map("recibido_en") @db.Timestamptz(6)
  entradaProcesamiento Json             @map("entrada_procesamiento") @db.JsonB
  estado              EstadoRecepcion   @default(PENDIENTE)
  intentos            Int               @default(0)
  disponibleEn        DateTime          @default(now()) @map("disponible_en") @db.Timestamptz(6)
  leaseOwner          String?           @map("lease_owner") @db.Text
  leaseHasta          DateTime?         @map("lease_hasta") @db.Timestamptz(6)
  ultimoError         String?           @map("ultimo_error") @db.Text
  procesadoEn         DateTime?         @map("procesado_en") @db.Timestamptz(6)

  bridge Bridge @relation(fields: [bridgeId], references: [id], onDelete: Restrict)
  lead   Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([bridgeId, idExternoLead])
  @@index([estado, disponibleEn], map: "idx_leads_recibidos_estado_disponible")
  @@map("leads_recibidos")
}

// Bloque B (Fase 3, diseño "Ambiguity persistence (NEW)"): cola de revisión
// del comparador en sombra `(cliente, empresa)` de "lead abierto"
// (`shadow-lead-scope.service.ts::compararLeadAbiertoScope`). Puramente
// observacional — ningún código de este cambio lee `resuelto` para decidir
// nada; queda para un futuro Bloque C. `empresaLeadId`/`empresaIngestaId`
// son escalares planos (sin FK a `Empresa`): una foto denormalizada de la
// colisión, deliberadamente desacoplada del ciclo de vida de `Empresa`.
// `@@unique([clienteId, leadAbiertoId, empresaIngestaId])`: upsert
// idempotente — una segunda repetición desde la MISMA empresa foránea sobre
// el MISMO lead abierto no duplica la fila.
model LeadAbiertoRevisionPendiente {
  id               String    @id @default(uuid()) @db.Uuid
  clienteId        String    @map("cliente_id") @db.Uuid
  leadAbiertoId    String    @map("lead_abierto_id") @db.Uuid
  empresaLeadId    String    @map("empresa_lead_id") @db.Uuid
  empresaIngestaId String    @map("empresa_ingesta_id") @db.Uuid
  detectadoEn      DateTime  @default(now()) @map("detectado_en") @db.Timestamptz(6)
  resuelto         Boolean   @default(false)
  resueltoEn       DateTime? @map("resuelto_en") @db.Timestamptz(6)

  cliente     Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  leadAbierto Lead    @relation(fields: [leadAbiertoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, leadAbiertoId, empresaIngestaId])
  @@index([resuelto])
  @@map("leads_abiertos_revision_pendiente")
}
