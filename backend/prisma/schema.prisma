generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum RolUsuario {
  ADMINISTRADOR
  SUPERVISOR
  ASESOR
  VENDEDOR

  @@map("rol_usuario")
}

model Usuario {
  id                 String     @id @default(uuid()) @db.Uuid
  nombre             String     @db.Text
  correo             String     @unique @db.Citext
  passwordHash       String     @map("password_hash") @db.Text
  rol                RolUsuario
  activo             Boolean    @default(true)
  ultimaAsignacionEn DateTime?  @map("ultima_asignacion_en") @db.Timestamptz(6)
  creadoEn           DateTime   @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn      DateTime   @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  leadEventos   LeadEvento[]

  @@map("usuarios")
}

// D-A: `jti` (UUID v4 generado en la emisión) es la PK — el 100% de los
// accesos a esta tabla es por `jti` (rotación, logout, detección de
// reutilización); un id sustituto no aportaría nada.
model RefreshToken {
  jti        String    @id @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  // D-B: sha256hex del JWT de refresco compacto completo. Nunca el token en
  // claro. El control primario de seguridad es la firma HMAC del JWT; este
  // hash es defensa en profundidad (ata la fila al string exacto del token).
  hash       String    @db.Text
  expiraEn   DateTime  @map("expira_en") @db.Timestamptz(6)
  revocadoEn DateTime? @map("revocado_en") @db.Timestamptz(6)
  creadoEn   DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, revocadoEn])
  @@map("refresh_tokens")
}

enum OrigenLead {
  NUEVO
  REINGRESO

  @@map("origen_lead")
}

enum EtapaLead {
  NUEVO
  CONTACTADO
  CITA
  VENTA
  NO_VENTA

  @@map("etapa_lead")
}

enum TipoEventoLead {
  INGRESO
  ASIGNACION
  REASIGNACION
  TRASPASO
  CAMBIO_ETAPA
  CAMBIO_SEMAFORO
  INTERACCION_REPETIDA
  CITA_AGENDADA
  CITA_REPROGRAMADA
  SLA_INCUMPLIDO
  CIERRE

  @@map("tipo_evento_lead")
}

model Cliente {
  id                  String   @id @default(uuid()) @db.Uuid
  nombre              String?  @db.Text
  telefonoOriginal    String?  @map("telefono_original") @db.Text
  telefonoNormalizado String?  @unique @map("telefono_normalizado") @db.Text
  telefonoValido      Boolean  @default(false) @map("telefono_valido")
  creadoEn            DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  correos CorreoCliente[]
  leads   Lead[]

  @@map("clientes")
}

model CorreoCliente {
  id                String  @id @default(uuid()) @db.Uuid
  clienteId         String  @map("cliente_id") @db.Uuid
  correo            String  @db.Text
  correoNormalizado String  @map("correo_normalizado") @db.Citext
  esPrincipal       Boolean @default(false) @map("es_principal")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, correoNormalizado])
  @@index([correoNormalizado])
  @@map("correos_cliente")
}

// Rebanada M3 (D2): `campania_id`, `semaforo`, `puntuacion`, `asesor_id`,
// `vendedor_id`, `sla_inicio_en`, `monto_venta`, `observacion_cierre` los
// añade el módulo que los puebla y los prueba (M5-M6), cada uno en su
// migración. `red_social`, `campos_dinamicos` y `payload_original` los añade
// M4 (ver abajo) porque es el primer módulo capaz de poblarlos.
model Lead {
  id              String     @id @default(uuid()) @db.Uuid
  clienteId       String     @map("cliente_id") @db.Uuid
  origen          OrigenLead
  etapa           EtapaLead  @default(NUEVO)
  // M4: nulo en leads previos a esta rebanada o de orígenes que aún no
  // reportan estos campos (docs/05-bridges.md §2).
  redSocial       RedSocial? @map("red_social")
  camposDinamicos Json?      @map("campos_dinamicos") @db.JsonB
  payloadOriginal Json?      @map("payload_original") @db.JsonB
  ingresadoEn     DateTime   @map("ingresado_en") @db.Timestamptz(6)
  cerradoEn       DateTime?  @map("cerrado_en") @db.Timestamptz(6)

  cliente        Cliente        @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  eventos        LeadEvento[]
  leadsRecibidos LeadRecibido[]

  @@index([clienteId, etapa])
  @@index([clienteId, cerradoEn(sort: Desc)])
  @@map("leads")
}

// `semaforo_anterior`/`semaforo_nuevo` requieren el enum `Semaforo`, que
// pertenece a M5 (D2).
model LeadEvento {
  id            String         @id @default(uuid()) @db.Uuid
  leadId        String         @map("lead_id") @db.Uuid
  usuarioId     String?        @map("usuario_id") @db.Uuid
  tipo          TipoEventoLead
  etapaAnterior EtapaLead?     @map("etapa_anterior")
  etapaNueva    EtapaLead?     @map("etapa_nueva")
  detalle       Json?          @db.JsonB
  ocurridoEn    DateTime       @default(now()) @map("ocurrido_en") @db.Timestamptz(6)

  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([leadId, ocurridoEn])
  @@index([tipo, ocurridoEn])
  @@map("lead_eventos")
}

enum RedSocial {
  FACEBOOK
  INSTAGRAM
  X
  LINKEDIN
  GOOGLE_FORMS

  @@map("red_social")
}

enum EstadoBridge {
  ACTIVO
  TOKEN_EXPIRADO
  ERROR
  INACTIVO

  @@map("estado_bridge")
}

enum NivelBridgeLog {
  INFO
  ADVERTENCIA
  ERROR

  @@map("nivel_bridge_log")
}

// Conexión con una red social (docs/05-bridges.md §1, §7). D-M4: el cifrado
// de token (`token_cifrado`, `secreto_webhook`) queda fuera de esta
// rebanada — no hay token reversible que cifrar todavía, Meta/LinkedIn
// quedan para un cambio SDD futuro — y lo añade el módulo que lo consuma.
model Bridge {
  id           String       @id @default(uuid()) @db.Uuid
  redSocial    RedSocial    @map("red_social")
  nombre       String       @db.Text
  // F2: hash sha256hex irreversible de la clave de API (`X-Bridge-Key`,
  // docs/05-bridges.md §5). La clave en claro nunca se persiste.
  claveApiHash String       @unique @map("clave_api_hash") @db.Text
  // Desactivado por defecto (docs/05-bridges.md §6): un bridge nuevo no
  // recibe leads hasta activación explícita.
  estado       EstadoBridge @default(INACTIVO)
  ultimoLeadEn DateTime?    @map("ultimo_lead_en") @db.Timestamptz(6)

  bridgeLogs     BridgeLog[]
  leadsRecibidos LeadRecibido[]

  @@map("bridges")
}

// Bitácora de errores/eventos por bridge (docs/05-bridges.md §8). Se escribe
// siempre fuera de la transacción de ingesta (DD5, diseño M4) para que
// sobreviva a un rollback.
model BridgeLog {
  id         String         @id @default(uuid()) @db.Uuid
  bridgeId   String?        @map("bridge_id") @db.Uuid
  nivel      NivelBridgeLog
  mensaje    String         @db.Text
  payload    Json?          @db.JsonB
  ocurridoEn DateTime       @default(now()) @map("ocurrido_en") @db.Timestamptz(6)

  bridge Bridge? @relation(fields: [bridgeId], references: [id], onDelete: SetNull)

  @@index([bridgeId, ocurridoEn(sort: Desc)])
  @@map("bridge_logs")
}

// Recepción cruda de cada lead entrante (F1: ausente hasta ahora de
// docs/03-modelo-datos.md). `UNIQUE(bridge_id, id_externo_lead)` es la
// defensa de idempotencia contra reintentos de webhook (docs/05-bridges.md
// §2). `leadId` es nulo hasta que la transacción de ingesta lo resuelve —
// no hay máquina de estados de recepción (D2, diseño M4, retirada).
model LeadRecibido {
  id               String   @id @default(uuid()) @db.Uuid
  bridgeId         String   @map("bridge_id") @db.Uuid
  idExternoLead    String   @map("id_externo_lead") @db.Text
  leadId           String?  @map("lead_id") @db.Uuid
  // Cuerpo crudo recibido; incluye la atribución de campaña sin resolver
  // (`idExternoCampania`, `nombreCampania`, `idExternoCuenta` — D4, diseño
  // M4: no se crean `campanias`/`cuentas_publicitarias` en esta rebanada).
  payload          Json     @db.JsonB
  datosIncompletos Boolean  @default(false) @map("datos_incompletos")
  recibidoEn       DateTime @default(now()) @map("recibido_en") @db.Timestamptz(6)

  bridge Bridge @relation(fields: [bridgeId], references: [id], onDelete: Restrict)
  lead   Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([bridgeId, idExternoLead])
  @@map("leads_recibidos")
}
